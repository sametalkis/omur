{
  "manifest_version": 3,
  "name": "Ömür",
  "version": "1.0.0",
  "description": "Her yeni sekmede 9 haneli anlık yaş sayacı ve vizyon panosu.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
